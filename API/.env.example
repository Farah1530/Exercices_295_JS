# Modele du fichier .env
# Copie ce fichier en ".env" puis remplis les valeurs avec tes propres parametres MySQL.

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_PORT=
DB_NAME=

# Cle secrete qui sert a signer les tokens (exercice 9)
# Mets ici une longue suite de caracteres au hasard, differente pour chaque installation
JWT_PRIVATE_KEY=
